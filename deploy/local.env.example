# Loaded by the local mitmdump process (see docs/DEPLOYMENT.md).
R2_RELAY_VPS_URL=https://YOUR_VPS_HOST:8443
R2_RELAY_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
# Optional CA path for VPS TLS validation. Omit when system CA trusts the VPS cert.
# R2_RELAY_VPS_CA_FILE=/path/to/trusted-vps-ca.pem
R2_RELAY_BUFFER_BUDGET=536870912

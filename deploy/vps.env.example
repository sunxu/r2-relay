# Install at /etc/r2-relay/vps.env with mode 0600; never commit real credentials.
R2_RELAY_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
R2_RELAY_CACHE_DIR=/var/lib/r2-relay/cache
R2_RELAY_MAX_EXECUTIONS=512
R2_RELAY_MAX_CONCURRENT=16
R2_RELAY_EXECUTION_TTL=900
R2_RELAY_MIN_FREE_BYTES=134217728
# Total retained base64 body characters for terminal R2 results (64 MiB).
R2_RELAY_MAX_RETAINED_RESULT_BYTES=67108864
